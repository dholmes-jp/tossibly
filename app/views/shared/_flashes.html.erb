<%# app/views/shared/_flashes.html.erb — bottom-right toast bubble.
    Auto-dismissed by flash_controller.js; styles in components/_alert.scss %>
<% if notice %>
  <div class="flash flash--notice" role="status" data-controller="flash">
    <%= notice %>
  </div>
<% end %>
<% if alert %>
  <div class="flash flash--alert" role="alert" data-controller="flash">
    <%= alert %>
  </div>
<% end %>
