{
"name": "Tossibly",
"short_name": "Tossibly",
"icons": [
<% icons_dir = Rails.root.join("app/assets/images/icons/") %>
<% files = Dir.entries(icons_dir).select { |f| !File.directory?(icons_dir.join(f)) && f.match?(/-\d{2,4}x\d{2,4}\.png\z/) } %>
<% files.each_with_index do |file, index| %>
  <% size = file.match(/-(?<size>\d{2,4}x\d{2,4})\.png\z/)[:size] %>
  {
  "src": "<%= image_path "icons/#{file}" %>",
  "sizes": "<%= size %>",
  "type": "image/png"
  }<%= "," unless (files.size - 1) == index %>
<% end %>
],
"start_url": "/",
"display": "standalone",
"scope": "/",
"description": "Before you toss it, see what's possible.",
"theme_color": "#1E4B2D",
"background_color": "#1E4B2D"
}
