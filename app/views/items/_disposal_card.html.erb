<%# app/views/items/_disposal_card.html.erb
    The scan page's own presentation of the DisposalPanelPresenter hash, styled to
    match .toss-card in pages/_scan.scss. Also renders fee[:notes] and an apply
    link when present — fee-tiered categories carry both. %>
<% if dispose[:chip] || dispose[:blurb] %>
  <div class="toss-card">
    <div class="toss-card__head">
      <span class="toss-card__name">Toss It</span>
      <span class="toss-chip"><%= dispose[:chip] %></span>
    </div>
    <p class="toss-card__blurb"><%= dispose[:blurb] %></p>
    <div class="toss-stats">
      <% if dispose[:category_name].present? %>
        <div class="toss-stat"><span class="k">Category</span><span class="v"><%= dispose[:category_name] %></span></div>
      <% end %>
      <div class="toss-stat"><span class="k">Cost</span><span class="v"><%= dispose[:cost] %></span></div>
      <% if dispose[:stat] %>
        <div class="toss-stat"><span class="k"><%= dispose[:stat][:k] %></span><span class="v"><%= dispose[:stat][:v] %></span></div>
      <% end %>
    </div>
    <%# Potted-plant tiles: each part shows the waste stream it ends up in.
        flame = combustible, flame + slash = non-combustible (not the bin —
        that means delete elsewhere in the app), shop = not collected. %>
    <% streams = [
         [/non-?combustible/i,                      "Non-combustible", '<span class="toss-part__stack"><i class="fa-solid fa-fire" aria-hidden="true"></i></span>'],
         [/combustible/i,                           "Combustible",     '<i class="fa-solid fa-fire" aria-hidden="true"></i>'],
         [/recycl|plastics collection/i,            "Recyclables",     '<i class="fa-solid fa-recycle" aria-hidden="true"></i>'],
         [/not collected|garden cent|shop|store/i,  "Not collected",   '<i class="fa-solid fa-shop" aria-hidden="true"></i>']
       ]
       stream_for = ->(text) { streams.find { |pattern, _, _| text.match?(pattern) } } %>

    <%# Potted plant: steps written as "Part: what to do" become one tile per part %>
    <% parts = dispose[:steps].map do |step|
         title, body = step.split(":", 2)
         body ? { title: title.strip, body: body.strip, stream: stream_for.call(step) } : nil
       end %>
    <% if parts.any? && parts.all? %>
      <div class="toss-parts">
        <% parts.each do |part| %>
          <% _, label, icon = part[:stream] %>
          <div class="toss-part">
            <span class="toss-part__icon"><%= icon ? icon.html_safe : (parts.index(part) + 1) %></span>
            <span class="toss-part__title"><%= part[:title] %></span>
            <% if label %><span class="toss-part__stream"><%= label %></span><% end %>
            <span class="toss-part__body"><%= part[:body] %></span>
          </div>
        <% end %>
      </div>
    <% else %>
      <%# Every other category: numbered rows %>
      <ol class="toss-steps toss-steps--icons">
        <% dispose[:steps].each_with_index do |step, i| %>
          <li class="toss-step">
            <span class="toss-step__icon"><%= i + 1 %></span>
            <span class="toss-step__text"><%= step %></span>
          </li>
        <% end %>
      </ol>
    <% end %>
    <% if dispose[:notes].present? %>
      <div class="dispose-notes">
        <% dispose[:notes].each do |note| %>
          <p class="dispose-note"><%= note %></p>
        <% end %>
      </div>
    <% end %>
    <% if dispose[:apply_url].present? %>
      <%= link_to dispose[:apply_label], dispose[:apply_url],
            target: "_blank", rel: "noopener", class: "dispose-apply" %>
    <% end %>
  </div>
<% else %>
  <p class="text-muted">Disposal category not yet determined for this item.</p>
<% end %>
