<div class="scan-followups">
  <%= hidden_field_tag "item[brand]", identification[:brand] %>
  <%= hidden_field_tag "item[category]", identification[:category] %>
  <%= hidden_field_tag "item[model_number]", identification[:model_number] %>
  <%= hidden_field_tag "item[condition_guess]", identification[:condition_guess] %>
  <%= hidden_field_tag "item[waste_category_key]", identification[:waste_category_key] %>
  <%= hidden_field_tag "item[listable]", identification[:listable],
        data: { "reuse-reveal-target": "listableField" } %>
  <%= hidden_field_tag "item[jimoty_search_keyword]", identification[:jimoty_search_keyword] %>

  <div class="scan-field">
    <span class="scan-field__label">Does it still work? What shape is it in?</span>
    <div class="condition-pills" data-photo-analyzer-target="conditionPills">
      <% ["New", "Like new", "Good", "Fair", "Not working"].each do |value| %>
        <label class="condition-pill <%= "active" if value == "Good" %>">
          <input type="radio" name="condition" value="<%= value %>" class="visually-hidden"
                 data-photo-analyzer-target="conditionRadio"
                 data-action="change->photo-analyzer#conditionChanged"
                 <%= "checked" if value == "Good" %>>
          <%= value %>
        </label>
      <% end %>
    </div>
  </div>

  <%= hidden_field_tag "item[functional]", "true", data: { photo_analyzer_target: "functionalInput" } %>

  <div class="scan-field">
    <label class="scan-field__label" for="note">Anything else we should know? (optional)</label>
    <%= text_field_tag :note, nil, class: "form-control",
          placeholder: "e.g. scratch on the back, comes with original box" %>
  </div>

  <% (identification[:follow_up_questions] || []).each do |question| %>
    <div class="scan-field">
      <label class="scan-field__label"><%= question %></label>
      <input type="text" name="item[follow_up_answers][]" class="form-control">
      <%= hidden_field_tag "item[follow_up_question_texts][]", question %>
    </div>
  <% end %>

  <%= submit_tag "Save and compare my options →", class: "scan-btn scan-btn--sun",
        data: { turbo_submits_with: "Saving…" } %>
</div>
