<div class="jimoty-details">
  <div class="jimoty-field">
    <p class="form-label">Listing title</p>
    <p class="jimoty-field__value">
      <%= item.title %>
    </p>
  </div>
  <div class="jimoty-field">
    <p class="form-label">Listing description (English)</p>
    <p class="jimoty-field__value">
      <%= item.description %>
    </p>
    <p class="jimoty-field__note">
      The Japanese description used by the extension isn't shown here.
    </p>
  </div>
  <div class="jimoty-field">
    <p class="form-label">Listing price (¥)</p>
    <p class="jimoty-field__value">
      <%= yen(item.confirmed_price.to_i) %>
    </p>
    <% if item.typical_price.present? %>
      <p class="jimoty-field__note">
        Tossibly suggests starting at <%= yen(item.typical_price) %> &mdash; expect buyers to negotiate down.
      </p>
    <% end %>
    <% if item.nearby_listings_found? %>
      <p class="jimoty-field__note">
        <% if item.search_scope == "tokyo" %>
          Nothing nearby right now, so this looks at listings across Tokyo.
        <% else %>
          Based on <%= item.nearby_count %> similar items listed near you right now.
        <% end %>
        These are asking prices, not what they sold for.
      </p>
    <% end %>
  </div>
</div>
