<div class="container items-show">
  <div class="section-head">
    <%= link_to items_path, class: "see-all" do %>
      <i class="fa-solid fa-arrow-left"></i>Back to My Items
    <% end %>
    <h1><!--i class="fas fa-route"></i--> What Do You Want To Do?</h1>
  </div>

  <%= turbo_stream_from @item %>
  <%= render "items/decision_card", item: @item %>
</div>
