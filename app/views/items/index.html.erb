<%# app/views/items/index.html.erb — My items %>
<%# Styles: app/assets/stylesheets/components/_items.scss %>
<%
  filtering   = params[:status].present? || params[:platform].present?
  total       = current_user.items.count
  shown       = @items.size
  count_label = (filtering && shown != total) ? "#{shown} of #{total} items" : pluralize(total, "item")
%>
<main class="items-page">
  <%# ---------- Header ---------- %>
  <div class="items-header">
    <h1>My items <span class="items-count"><%= count_label %></span></h1>
    <%= link_to new_item_path, class: "items-scan scan-action scan-action--pill" do %>
      <%= render "shared/scan_camera" %>
      <span class="scan-action__label">Scan an item</span>
    <% end %>
  </div>
  <%# ---------- Platform filter ---------- %>
  <div class="items-chips items-chips--platforms">
    <%= link_to "All items",
          items_path,
          class: "items-chip #{'items-chip--active' if params[:platform].blank?}" %>
    <% Item::PLATFORMS.each do |platform, label| %>
      <%= link_to label,
        items_path(platform: platform),
        class: "items-chip #{'items-chip--active' if params[:platform] == platform}" %>
    <% end %>
  </div>
  <%# ---------- Status filter by platform ---------- %>
  <% statuses =
    if params[:platform].present?
      Item::STATUSES_BY_PLATFORM[params[:platform]]
    else
      Item::STATUSES_BY_PLATFORM.values.flatten.uniq
    end
  %>
  <% if statuses.present? %>
    <div class="items-chips">
      <%= link_to "All",
          items_path(platform: params[:platform]),
          class: "items-chip #{'items-chip--active' if params[:status].blank?}" %>
      <% statuses.each do |status| %>
        <%= link_to Item::STATUS_LABELS[status],
      items_path(status: status, platform: params[:platform]),
      class: "items-chip #{'items-chip--active' if params[:status] == status}" %>
      <% end %>
    </div>
  <% end %>
  <%# ---------- List ---------- %>
  <% if @items.any? %>
    <div class="items-list">
      <% @items.each do |item| %>
        <article class="items-card">
          <div class="items-card__photo">
            <% if item.photos.attached? %>
              <%= image_tag item.photos.first, alt: item.title %>
            <% elsif item_image(item) %>
              <%= image_tag item_image(item), alt: item.title %>
            <% else %>
              <i class="fa-solid fa-box-open" aria-hidden="true"></i>
            <% end %>
          </div>
          <div class="items-card__body">
            <%# The title link is stretched to cover the whole card %>
            <h2 class="items-card__title">
              <%= link_to item.title, item_path(item), class: "stretched-link" %>
            </h2>
            <p class="items-card__desc"><%= item.description %></p>
            <div class="items-card__meta">
              <span class="items-pill <%= 'items-pill--warn' unless item.functional %>">
                <%= item.functional ? "Working" : "Not working" %>
              </span>
              <%# Status %>
              <%# Status: pill opens a menu of buttons, each one PATCHes the status %>
              <details class="items-status">
                <summary class="items-status__current items-pill status--<%= item.status %>">
                  <%= Item::STATUS_LABELS[item.status] || item.status.humanize %>
                  <i class="fa-solid fa-angle-down" aria-hidden="true"></i>
                </summary>
                <div class="items-status__menu">
                  <% item.available_statuses.each do |status| %>
                    <%= button_to Item::STATUS_LABELS[status] || status.humanize,
                          item_path(item),
                          method: :patch,
                          params: { item: { status: status } },
                          class: "items-status__option #{'items-status__option--active' if status == item.status}",
                          form_class: "items-status__option-form" %>
                  <% end %>
                </div>
              </details>
              <%# Delete: sits above the stretched link so it doesn't open the item %>
              <%= button_to item_path(item),
                    method: :delete,
                    class: "items-delete",
                    form_class: "items-delete-form",
                    form: { data: { turbo_confirm: "Delete “#{item.title}”? This can't be undone." } },
                    "aria-label": "Delete #{item.title}",
                    title: "Delete" do %>
                <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
              <% end %>
              <% if item.age.present? %>
                <span><%= item.age.to_s.include?("year") ? item.age : pluralize(item.age, "year") %> old</span>
              <% end %>
            </div>
          </div>
          <i class="fa-solid fa-chevron-right items-card__chevron" aria-hidden="true"></i>
        </article>
      <% end %>
    </div>
    <%# ---------- Empty states ---------- %>
  <% else %>
    <div class="items-empty">
      <% if filtering %>
        <h2>No items match this filter</h2>
        <p>Try a different filter — or scan something new.</p>
      <% else %>
        <h2>Nothing scanned yet</h2>
        <p>Scan your first item and Tossibly will take it from there.</p>
      <% end %>
      <%= link_to new_item_path, class: "items-scan scan-action scan-action--pill" do %>
        <%= render "shared/scan_camera" %>
        <span class="scan-action__label">Scan an item</span>
      <% end %>
    </div>
  <% end %>
</main>
