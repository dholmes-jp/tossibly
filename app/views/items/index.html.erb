<div class="items-page">
<%= image_tag "tossibly-leaves.png", class: "items-page__leaves", alt: "" %>
<div class="container items-page__inner py-4">

  <div class="items-page__header">
    <h1 class="items-page__title">
      <i class="fa-solid fa-leaf"></i> My Items
    </h1>
    <%= link_to new_item_path, class: "items-page__scan" do %>
      Scan an item <i class="fa-solid fa-arrow-right"></i>
    <% end %>
  </div>

  <div class="chips">
    <%= link_to "All",
          items_path(platform: params[:platform]),
          class: "chip #{'chip--active' if params[:status].blank?}" %>
    <% Item::STATUSES.each do |status| %>
      <%= link_to status.titleize,
            items_path(status: status, platform: params[:platform]),
            class: "chip #{'chip--active' if params[:status] == status}" %>
    <% end %>
  </div>

  <div class="chips chips--platforms">
    <%= link_to "All platforms",
          items_path(status: params[:status]),
          class: "chip #{'chip--active' if params[:platform].blank?}" %>
    <% Item::PLATFORMS.each do |platform| %>
      <%= link_to platform.titleize,
            items_path(status: params[:status], platform: platform),
            class: "chip #{'chip--active' if params[:platform] == platform}" %>
    <% end %>
  </div>

  <% if @items.any? %>
    <div class="item-list">
      <% @items.each do |item| %>
        <%= link_to item_path(item), class: "item-card" do %>

          <% if item.photos.attached? %>
            <%= image_tag item.photos.first, class: "item-card__img", alt: item.title %>
          <% elsif item_image(item) %>
            <%= image_tag item_image(item), class: "item-card__img", alt: item.title %>
          <% else %>
            <div class="item-card__img item-card__img--empty">
              <i class="fa-solid fa-box-open"></i>
            </div>
          <% end %>

          <div class="item-card__body">
            <h2 class="item-card__title"><%= item.title %></h2>
            <p class="item-card__desc"><%= item.description %></p>
            <p class="item-card__meta">
              <% if item.age.present? %>
                <span><%= item.age.to_s.include?("year") ? item.age : pluralize(item.age, "year") %> old</span>
              <% end %>
              <span><%= item.functional ? "Working" : "Not working" %></span>
            </p>
          </div>

          <i class="fa-solid fa-chevron-right item-card__chevron"></i>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="items-page__empty">
      <p>No items match these filters yet.</p>
      <%= link_to new_item_path, class: "items-page__scan" do %>
        Scan an item <i class="fa-solid fa-arrow-right"></i>
      <% end %>
    </div>
   <% end %>

</div>
</div>
