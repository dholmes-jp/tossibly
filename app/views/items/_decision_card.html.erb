<%# app/views/items/_decision_card.html.erb — item decision page body %>
<%# Live-updated via turbo_stream_from @item: the wrapper id below must stay. %>
<%# Renders items/jimoty_form (in the edit dialog) and items/dispose_details unchanged. %>
<%# JS: decision_card_controller.js (details toggle + edit dialog). %>
<%# Styles: app/assets/stylesheets/pages/_decision.scss %>

<div id="<%= dom_id(item, :decision) %>" class="decision-card decide" data-controller="decision-card">

  <% if !item.processed? && item.listable? %>
    <div class="decide-pending">
      <div class="spinner-border" role="status" aria-hidden="true"></div>
      <p class="decide-pending__headline">Looking at what similar items are going for nearby&hellip;</p>
      <p class="decide-pending__sub">This usually takes a few seconds</p>
    </div>

  <% else %>
    <%
      waste_category = item.waste_category
      fee            = DisposalFeeEstimator.call(item)
      single_path    = !item.listable

      dispose = if waste_category
        {
          chip: waste_category.chip_label,
          blurb: waste_category.blurb,
          cost: fee.label,
          stat: waste_category.collection_frequency.present? ? { k: "Collected", v: waste_category.collection_frequency } : nil,
          facts: [["Category", waste_category.name], ["Cost", fee.label],
                  ["Application", waste_category.application_required? ? "Required" : "Not required"]],
          steps: waste_category.steps,
          notes: fee.notes,
          apply_url: fee.application_url,
          apply_label: fee.application_label
        }
      else
        { chip: nil, blurb: "Disposal category not yet determined for this item.",
          cost: nil, stat: nil, facts: [], steps: [], notes: [],
          apply_url: nil, apply_label: nil }
      end

      # Which path gets the "Tossibly suggests" tag. Working + listable → List, otherwise Toss.
      suggested    = (item.functional && !single_path) ? :list : :toss
      priced_count = item.nearby_listings_found? ? [item.nearby_count.to_i - item.free_count.to_i, 0].max : 0
      area_label   = item.search_scope == "tokyo" ? "Across Tokyo" : "Meguro + nearby wards"
    %>

    <p class="decide-summary">
      <% if single_path %>
        <strong>This one goes the disposal route.</strong> Here's exactly how to do it under Meguro rules.
      <% elsif suggested == :list %>
        <strong>Both options are realistic.</strong> Listing it is free and someone nearby may take it; tossing it correctly is simpler but usually costs money.
      <% else %>
        <strong>Tossing it is the cleaner option.</strong> It's marked not working, though some people take items for parts.
      <% end %>
    </p>

    <div class="decide-board <%= 'decide-board--single' if single_path %>">

      <%# ================= Item card ================= %>
      <article class="decide-item">
        <div class="decide-item__photo">
          <% if item.photos.attached? %>
            <%= image_tag item.photos.first, alt: item.title %>
          <% end %>
        </div>

        <span class="decide-pill <%= item.functional ? '' : 'decide-pill--warn' %>">
          <%= item.functional ? "Working" : "Not working" %>
        </span>
        <h2 class="decide-item__title"><%= item.title %></h2>
        <% meta = [item.brand, item.model_number].compact_blank.join(" · ") %>
        <% if meta.present? %><p class="decide-item__meta"><%= meta %></p><% end %>

        <dl class="decide-rows">
          <% if item.category.present? %><div><dt>Category</dt><dd><%= item.category %></dd></div><% end %>
          <% if item.brand.present? %><div><dt>Brand</dt><dd><%= item.brand %></dd></div><% end %>
          <div><dt>Condition</dt><dd><%= item.functional ? "Working" : "Not working" %></dd></div>
          <% if waste_category %><div><dt>Waste type</dt><dd><%= waste_category.name %></dd></div><% end %>
        </dl>

        <% if item.description.present? %>
          <div class="decide-noticed">
            <p class="decide-noticed__label">What we noticed</p>
            <p class="decide-noticed__preview"><%= item.description %></p>
            <details class="decide-more">
              <summary>Show more</summary>
              <p class="decide-noticed__full"><%= item.description %></p>
            </details>
          </div>
        <% end %>

        <% unless single_path %>
          <button type="button" class="decide-btn decide-btn--secondary decide-item__edit"
                  data-action="decision-card#openEditor">Edit item details</button>
        <% end %>
      </article>

      <%# ================= List It ================= %>
      <% unless single_path %>
        <article class="decide-option decide-option--list <%= 'decide-option--suggested' if suggested == :list %>">
          <% if suggested == :list %><span class="decide-suggests">Tossibly suggests</span><% end %>

          <div class="decide-option__head">
            <div>
              <h3 class="decide-option__title">List it</h3>
              <p class="decide-option__sub">Pass it on to someone nearby, free or for a price.</p>
            </div>
            <span class="decide-tag">Reuse</span>
          </div>

          <div class="decide-metrics">
            <% if item.nearby_listings_found? %>
              <div class="decide-metric"><b><%= item.nearby_count %></b><span>similar live listings</span></div>
              <div class="decide-metric"><b><%= item.free_count %> free</b><span><%= priced_count %> priced</span></div>
              <% if item.typical_price.present? %>
                <div class="decide-metric"><b><%= yen(item.typical_price) %></b><span>typical asking price</span></div>
              <% else %>
                <div class="decide-metric"><b>Free</b><span>to list</span></div>
              <% end %>
            <% else %>
              <div class="decide-metric"><b>0</b><span>similar listings nearby</span></div>
              <div class="decide-metric"><b>Free</b><span>to list</span></div>
              <div class="decide-metric"><b>Pickup</b><span>buyer collects</span></div>
            <% end %>
          </div>

          <dl class="decide-rows">
            <div><dt>Search area</dt><dd><%= area_label %></dd></div>
            <div><dt>Listing cost</dt><dd>Free</dd></div>
            <div><dt>Prices shown</dt><dd>Asking, not sold</dd></div>
          </dl>

          <div class="decide-info">
            <% if !item.nearby_listings_found? %>
              No comparable items are live nearby right now. Listings can still work &mdash; demand changes week to week.
            <% elsif item.search_scope == "tokyo" %>
              Not enough comparable items were live in Meguro-ku, so the search widened to listings across Tokyo.
            <% else %>
              <%= item.nearby_count %> comparable items are live in Meguro and nearby wards, so the numbers above reflect your area.
            <% end %>
          </div>

          <div class="decide-actions">
            <%# Quick path for users who've already decided: straight to Jimoty. %>
            <%= link_to "https://jmty.jp/articles/new?prefecture_id=0/", class: "decide-btn decide-btn--primary", target: "_blank", rel: "noopener" do %>
              Choose List It <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
            <% end %>
            <button type="button" class="decide-btn decide-btn--secondary"
                    data-action="decision-card#toggle" data-decision-card-panel-param="list">More details</button>
          </div>

          <div class="decide-details" hidden data-decision-card-target="panel" data-panel="list">
            <%# 1) Tossibly's recommendation from the nearby-listing analysis, as bullets %>
            <div class="decide-block">
              <p class="decide-details__title">Tossibly's take</p>
              <ul class="decide-bullets">
              <% if item.typical_price.present? %>
                <li><strong>Tossibly suggests starting at <%= yen(item.typical_price) %></strong> &mdash; expect buyers to negotiate down.</li>
              <% elsif item.nearby_listings_found? %>
                <li><strong>Tossibly suggests listing it free</strong> &mdash; every similar item nearby is being given away.</li>
              <% else %>
                <li><strong>No price suggestion yet</strong> &mdash; no comparable listings are live nearby right now.</li>
              <% end %>
              <% if item.nearby_listings_found? %>
                <li>Based on <strong><%= item.nearby_count %> similar items</strong> listed
                  <%= item.search_scope == "tokyo" ? "across Tokyo" : "near you" %> right now,
                  <%= item.free_count %> of them free.</li>
                <% if item.search_scope == "tokyo" %>
                  <li>Nothing comparable was live in Meguro-ku, so the search widened to all of Tokyo.</li>
                <% end %>
                <li>These are asking prices, not what items actually sold for.</li>
              <% else %>
                <li>Demand changes week to week &mdash; a listing can still work, and it's free to post.</li>
              <% end %>
              </ul>
            </div>

            <%# 2) The AI-written listing draft %>
            <div class="decide-block">
              <p class="decide-details__title">Your listing draft</p>
              <div class="decide-draft">
              <div class="decide-draft__field">
                <p class="decide-draft__label">Listing title</p>
                <p class="decide-draft__value"><%= item.title %></p>
              </div>
              <div class="decide-draft__field">
                <p class="decide-draft__label">Listing description (English)</p>
                <p class="decide-draft__value"><%= item.description %></p>
              </div>
              <div class="decide-draft__field">
                <p class="decide-draft__label">Your listing price</p>
                <p class="decide-draft__value">
                  <%= item.confirmed_price.to_i.zero? ? "Free" : yen(item.confirmed_price.to_i) %>
                </p>
              </div>
              </div>
              <div class="decide-draft__actions">
                <span>Title, description and price are editable</span>
                <button type="button" class="decide-mini" data-action="decision-card#openEditor">Edit draft</button>
              </div>
            </div>

            <%# 3) How to post it %>
            <div class="decide-inline">
              <div><strong>Ready to post?</strong><span>Opens Jimoty in a new tab &mdash; paste the Japanese draft there</span></div>
              <%= link_to "https://jmty.jp/articles/new?prefecture_id=0/", class: "decide-mini decide-mini--primary", target: "_blank", rel: "noopener" do %>
                Post on Jimoty <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
              <% end %>
            </div>
          </div>
        </article>
      <% end %>

      <%# ================= Toss It ================= %>
      <article class="decide-option decide-option--toss <%= 'decide-option--suggested' if suggested == :toss %>">
        <% if suggested == :toss %><span class="decide-suggests">Tossibly suggests</span><% end %>

        <div class="decide-option__head">
          <div>
            <h3 class="decide-option__title">Toss it</h3>
            <p class="decide-option__sub">Dispose of it correctly under Meguro rules.</p>
          </div>
          <span class="decide-tag"><%= dispose[:chip].presence || "Dispose" %></span>
        </div>

        <div class="decide-metrics">
          <div class="decide-metric"><b><%= dispose[:cost].presence || "TBD" %></b><span>cost</span></div>
          <div class="decide-metric">
            <b><%= waste_category&.application_required? ? "Required" : "Not needed" %></b><span>application</span>
          </div>
          <div class="decide-metric">
            <b><%= dispose[:stat] ? dispose[:stat][:v] : "Ward rules" %></b><span><%= dispose[:stat] ? dispose[:stat][:k].downcase : "route" %></span>
          </div>
        </div>

        <dl class="decide-rows">
          <% dispose[:facts].each do |k, v| %>
            <div><dt><%= k %></dt><dd><%= v %></dd></div>
          <% end %>
        </dl>

        <div class="decide-info">
          <%= dispose[:notes].first.presence || dispose[:blurb] %>
        </div>

        <div class="decide-actions">
          <%# Quick path for users who've already decided: straight to the ward's
              online application. Categories with nothing to apply for (combustible,
              recyclables…) have no URL, so the button opens the steps instead. %>
          <% if dispose[:apply_url].present? %>
            <%= link_to dispose[:apply_url], class: "decide-btn decide-btn--primary", target: "_blank", rel: "noopener" do %>
              Choose Toss It <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
            <% end %>
          <% else %>
            <button type="button" class="decide-btn decide-btn--primary"
                    data-action="decision-card#choose" data-decision-card-panel-param="toss">Choose Toss It</button>
          <% end %>
          <button type="button" class="decide-btn decide-btn--secondary"
                  data-action="decision-card#toggle" data-decision-card-panel-param="toss">More details</button>
        </div>

        <div class="decide-details" <%= 'hidden' unless single_path %> data-decision-card-target="panel" data-panel="toss">
          <p class="decide-details__title">How to toss it correctly</p>
          <%= render "items/dispose_details", dispose: dispose %>
        </div>
      </article>
    </div>

    <p class="decide-footnote">
      No rush &mdash; this item is saved as <strong>Pending</strong> in My Items. Decide now, or come back later.
    </p>

    <%# ================= Edit draft dialog (their jimoty_form, unchanged) ================= %>
    <% unless single_path %>
      <dialog class="decide-dialog" data-decision-card-target="dialog" data-action="click->decision-card#backdrop">
        <div class="decide-dialog__inner">
          <h4>Review listing draft</h4>
          <p>Changes are saved without leaving the comparison screen.</p>
          <%= render "items/jimoty_form", item: item %>
          <button type="button" class="decide-btn decide-btn--secondary decide-dialog__cancel"
                  data-action="decision-card#closeEditor">Cancel</button>
        </div>
      </dialog>
    <% end %>
  <% end %>
</div>
