<div id="<%= dom_id(item, :decision) %>" class="decision-card" data-controller="item-decision">
  <div class="item-head">
    <% if item.photos.attached? %>
      <%= image_tag item.photos.first, class: "item-head-thumb", alt: item.title %>
    <% end %>

    <div class="item-head-info">
      <h1 class="h5 mb-1"><%= item.title %></h1>
      <p class="text-muted small mb-2">
        <%= item.functional ? "Working" : "Not working" %>
        <% if item.brand.present? %> &middot; <%= item.brand %><% end %>
        <% if item.model_number.present? %> &middot; <%= item.model_number %><% end %>
      </p>
      <% if item.category.present? %>
        <p class="text-muted small mb-2">Waste category: <strong><%= item.category %></strong></p>
      <% end %>

      <%= link_to "Edit details", edit_item_path(item), class: "small" %>
    </div>
  </div>

  <% if !item.processed? && item.listable? %>
    <div class="decision-pending">
      <div class="spinner-border" role="status" aria-hidden="true"></div>
      <p class="submit-overlay-headline">Looking at what similar items are going for nearby&hellip;</p>
      <p class="submit-overlay-subline">This usually takes a few seconds</p>
    </div>
  <% else %>
    <h3 class="h6 mb-3">Compare your options</h3>

        <%
          waste_category = item.waste_category
          fee            = DisposalFeeEstimator.call(item)
          single_path    = !item.listable
          comps          = { nearby_listings: 5, asking_low: 1_000, asking_high: 4_000 }
          asking_range   = "#{yen(comps[:asking_low])}&ndash;#{yen(comps[:asking_high])}".html_safe

          dispose = if waste_category
            {
              chip: waste_category.chip_label,
              blurb: waste_category.blurb,
              cost: fee.label,
              stat: waste_category.collection_frequency.present? ? { k: "Collected", v: waste_category.collection_frequency } : nil,
              facts: [["Category", waste_category.name], ["Cost", fee.label],
                      ["Application", waste_category.application_required? ? "Required" : "Not required"]],
              steps: waste_category.steps,
              notes: fee.notes,
              apply_url: fee.application_url,
              apply_label: fee.application_label
            }
          else
            { chip: nil, blurb: "Disposal category not yet determined for this item.",
              cost: nil, stat: nil, facts: [], steps: [], notes: [],
              apply_url: nil, apply_label: nil }
          end
        %>

        <% unless single_path %>
          <div class="view-control" role="group" aria-label="Which path to show">
            <button type="button" class="view-control__btn is-on" data-state="both" aria-pressed="true"
                    data-item-decision-target="viewButton" data-action="item-decision#showBoth">Compare both</button>
            <button type="button" class="view-control__btn" data-state="jimoty" aria-pressed="false"
                    data-item-decision-target="viewButton" data-action="item-decision#expandJimoty">Jimoty</button>
            <button type="button" class="view-control__btn" data-state="dispose" aria-pressed="false"
                    data-item-decision-target="viewButton" data-action="item-decision#expandDispose">Dispose</button>
          </div>
        <% end %>

        <% if single_path %>
          <div class="compare-single">
            <div class="path-card path-card--dispose">
              <div class="path-card__head">
                <span class="path-name">Dispose</span>
              </div>
              <p class="path-blurb"><%= dispose[:blurb] %></p>
              <%= render "items/dispose_details", dispose: dispose %>
            </div>
          </div>
        <% else %>
          <div class="compare-paths" data-state="both" data-item-decision-target="paths">
            <div class="path-slot path-slot--jimoty">
              <div class="path-card path-card--jimoty">
                <div class="path-card__head">
                  <span class="path-name">Jimoty</span>
                  <span class="path-chip">Free to list</span>
                </div>
                <p class="path-blurb">
                  Listing it locally is low-effort &mdash; buyers come to you, and there's no shipping to deal with.
                </p>
                <div class="path-stats">
                  <div class="path-stat">
                    <span class="path-stat__k">Nearby</span>
                    <span class="path-stat__v"><%= comps[:nearby_listings] %> similar listings</span>
                  </div>
                  <div class="path-stat">
                    <span class="path-stat__k">Asking</span>
                    <span class="path-stat__v"><%= asking_range %></span>
                  </div>
                </div>
                <button type="button" class="btn-platform btn-jimoty path-cta"
                        data-action="item-decision#expandJimoty">
                  <i class="fas fa-location-dot"></i> List on Jimoty &rarr;
                </button>

                <div class="path-expanded">
                  <%= form_with model: item, method: :patch, class: "jimoty-form" do |f| %>
                    <div class="jimoty-field">
                      <%= f.label :title, "Listing title", class: "form-label" %>
                      <%= f.text_field :title, class: "form-control" %>
                    </div>

                    <div class="jimoty-field">
                      <%= f.label :description, "Listing description (English)", class: "form-label" %>
                      <%= f.text_area :description, rows: 4, class: "form-control" %>
                      <p class="jimoty-field__note">
                        The Japanese description used by the extension isn't shown here.
                      </p>
                    </div>

                    <div class="jimoty-field">
                      <%= f.label :confirmed_price, "Listing price (¥)", class: "form-label" %>
                      <%# confirmed_price column-defaults to 0. Show the saved value, or 0 when nothing has been
                          set yet — the AI suggestion is never dropped into the field, only shown in the note below. %>
                      <%= f.number_field :confirmed_price, value: item.confirmed_price.to_i,
                            min: 0, class: "form-control" %>
                      <% if item.suggested_price.present? %>
                        <p class="jimoty-field__note">
                          AI suggested <%= yen(item.suggested_price) %> from
                          <%= comps[:nearby_listings] %> nearby listings (<%= asking_range %>)
                        </p>
                      <% end %>
                    </div>

                    <%# description_ja is intentionally left untouched on save. Regenerating the
                        Japanese copy the Chrome extension autofills on Jimoty needs a real
                        translation (LLM) call, which belongs in its own pass — not this form. %>

                    <%= f.submit "Save listing details", class: "btn-platform btn-jimoty jimoty-form__save" %>
                  <% end %>

                  <div class="path-back">
                    <button type="button" class="path-back__btn" data-action="item-decision#showBoth">
                      &larr; Compare both paths again
                    </button>
                  </div>
                </div>
              </div>
            </div>

            <div class="path-slot path-slot--dispose">
              <div class="path-card path-card--dispose">
                <div class="path-card__head">
                  <span class="path-name">Dispose</span>
                  <% if dispose[:chip] %><span class="path-chip"><%= dispose[:chip] %></span><% end %>
                </div>
                <p class="path-blurb"><%= dispose[:blurb] %></p>
                <div class="path-stats">
                  <% if dispose[:cost] %>
                    <div class="path-stat">
                      <span class="path-stat__k">Cost</span>
                      <span class="path-stat__v"><%= dispose[:cost] %></span>
                    </div>
                  <% end %>
                  <% if dispose[:stat] %>
                    <div class="path-stat">
                      <span class="path-stat__k"><%= dispose[:stat][:k] %></span>
                      <span class="path-stat__v"><%= dispose[:stat][:v] %></span>
                    </div>
                  <% end %>
                </div>
                <button type="button" class="btn-platform btn-dispose path-cta"
                        data-action="item-decision#expandDispose">
                  <i class="fas fa-truck"></i> See disposal steps &rarr;
                </button>

                <div class="path-expanded">
                  <%= render "items/dispose_details", dispose: dispose %>
                  <div class="path-back">
                    <button type="button" class="path-back__btn" data-action="item-decision#showBoth">
                      &larr; Compare both paths again
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% end %>

        <p class="small text-muted mb-0">
          No rush &mdash; this item is saved as <strong>Pending</strong> in My Items. Decide now, or come back later.
        </p>
  <% end %>
</div>
