<div id="identification" class="scan-result">
  <% if identification[:name].present? %>
    <p class="scan-result__eyebrow">We found something</p>
    <h3 class="scan-result__name"><%= identification[:name] %></h3>
    <% if identification[:brand].present? || identification[:model_number].present? %>
      <p class="scan-result__sub">
        <%= [identification[:brand], identification[:model_number]].compact_blank.join(" · ") %>
      </p>
    <% end %>
    <p class="scan-result__confidence">Did we get it right? Adjust anything below before we work out the best way to let it go.</p>
  <% end %>
</div>
